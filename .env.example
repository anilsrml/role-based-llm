# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose.yml)
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/company
TOOL_DATABASE_URL=postgresql+psycopg://tool_reader:tool_reader@localhost:5433/company
CHAINLIT_DATABASE_URL=postgresql+asyncpg://chainlit:chainlit@localhost:5433/chainlit

# LLM (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Chainlit login tokens are signed with this. Generate: openssl rand -hex 32
# (chainlit create-secret output can contain "$", which docker compose reads as a variable)
CHAINLIT_AUTH_SECRET=

# Monitoring (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
